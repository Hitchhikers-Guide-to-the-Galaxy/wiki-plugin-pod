{
  "name": "wiki-plugin-pod",
  "version": "1.0.0",
  "description": "Federated Wiki - Pod Plugin — gather configurable pods of related wiki sites (sisters, parent, children, farm, neighbourhood) into your neighborhood",
  "type": "module",
  "main": "client/pod.js",
  "files": [
    "api",
    "client",
    "pages",
    "server",
    "src",
    "factory.json"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node test/vocabulary.mjs"
  },
  "keywords": [
    "pod",
    "wiki",
    "federated wiki",
    "plugin",
    "neighborhood",
    "sisters"
  ],
  "author": "David Bovill",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-pod.git"
  },
  "bugs": {
    "url": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-pod/issues"
  },
  "homepage": "https://github.com/Hitchhikers-Guide-to-the-Galaxy/wiki-plugin-pod#readme",
  "fedwiki": {
    "api": {
      "version": 1,
      "spec": "api/openapi.json",
      "handlers": "api/handlers.js",
      "vocabulary": "src/pod/commands.js"
    }
  }
}
